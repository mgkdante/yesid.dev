{
  "app": "apps/web",
  "rules": [
    {
      "specs": [
        "head.spec.ts"
      ],
      "path": "apps/web/src/routes/robots.txt/+server.ts"
    },
    {
      "specs": [
        "head.spec.ts"
      ],
      "path": "apps/web/src/routes/sitemap.xml/+server.ts"
    }
  ],
  "browserGroups": [
    {
      "match": ".*",
      "allProjects": [
        "*"
      ],
      "projects": [
        "phone",
        "desktop"
      ]
    }
  ],
  "playwright": "playwright.changed.config.ts",
  "unitEnv": {
    "EXPORT_FALLBACKS_SOURCE": "fixture"
  },
  "specDir": "apps/web/tests",
  "generatedInputs": [
    {
      "prefix": "apps/cms/scripts/",
      "workspaces": [
        "apps/web"
      ]
    },
    {
      "prefix": "apps/cms/fixtures/",
      "workspaces": [
        "apps/web"
      ]
    },
    {
      "prefix": "packages/shared/fixtures/",
      "workspaces": [
        "apps/web"
      ]
    }
  ],
  "fullPlaywright": "playwright.config.ts"
}
