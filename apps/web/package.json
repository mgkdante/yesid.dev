{
	"name": "@repo/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "bun ../../apps/cms/scripts/export-fallbacks.ts",
		"dev": "vite dev",
		"prebuild": "bun ../../apps/cms/scripts/export-fallbacks.ts",
		"build": "vite build && vitest run src/tests/sitemap-coverage.test.ts",
		"check:sitemap": "vitest run src/tests/sitemap-coverage.test.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "EXPORT_FALLBACKS_SOURCE=fixture bun ../../apps/cms/scripts/export-fallbacks.ts",
		"check": "svelte-kit sync && node scripts/check-svelte-warnings.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"pretest": "EXPORT_FALLBACKS_SOURCE=fixture bun ../../apps/cms/scripts/export-fallbacks.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:prebuilt": "E2E_PREBUILT=1 playwright test",
		"bundle-size": "bun run build && echo 'Bundle stats at dist/stats.html'",
		"check:client-payload": "node scripts/check-client-payload.mjs",
		"check:csp": "bun scripts/check-csp.ts",
		"lint:design": "bun tools/lint-design.ts",
		"precheck:watch": "EXPORT_FALLBACKS_SOURCE=fixture bun ../../apps/cms/scripts/export-fallbacks.ts",
		"pretest:unit": "EXPORT_FALLBACKS_SOURCE=fixture bun ../../apps/cms/scripts/export-fallbacks.ts",
		"pretest:watch": "EXPORT_FALLBACKS_SOURCE=fixture bun ../../apps/cms/scripts/export-fallbacks.ts",
		"precheck:sitemap": "EXPORT_FALLBACKS_SOURCE=fixture bun ../../apps/cms/scripts/export-fallbacks.ts"
	},
	"devDependencies": {
		"@csstools/postcss-global-data": "4.0.0",
		"@faker-js/faker": "^10.4.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/sanitize-html": "2.16.1",
		"@yesid/gates": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-gates-0.30.2.tgz",
		"bits-ui": "^2.16.3",
		"embla-carousel-svelte": "^8.6.0",
		"happy-dom": "^21.0.4",
		"interface-forge": "^2.6.6",
		"postcss-custom-media": "12.0.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svgo": "^4.0.1",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@lucide/svelte": "^1.18.0",
		"@repo/shared": "workspace:*",
		"@resvg/resvg-js": "^2.6.2",
		"@yesid/analytics": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-analytics-0.30.2.tgz",
		"@yesid/i18n-core": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-i18n-core-0.30.2.tgz",
		"@yesid/motion": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-motion-0.30.2.tgz",
		"@yesid/seo-kit": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-seo-kit-0.30.2.tgz",
		"@yesid/tokens": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-tokens-0.30.2.tgz",
		"@yesid/ui": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.30.2/yesid-ui-0.30.2.tgz",
		"embla-carousel": "^8.6.0",
		"embla-carousel-wheel-gestures": "^8.1.0",
		"gsap": "^3.14.2",
		"marked": "^18.0.2",
		"mermaid": "^11.16.1",
		"sanitize-html": "2.18.1",
		"satori": "^0.33.5",
		"shiki": "^4.0.2",
		"zod": "^4.3.6"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
