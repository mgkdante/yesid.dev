{
  "collection": "blog_posts",
  "meta": {
    "accountability": "all",
    "archive_app_filter": true,
    "archive_field": "status",
    "archive_value": "archived",
    "autosave_revision_interval": null,
    "collapse": "open",
    "collection": "blog_posts",
    "color": null,
    "display_template": "{{title}} ({{lang}})",
    "group": "blog_page",
    "hidden": false,
    "icon": "article",
    "item_duplication_fields": [
      "sort",
      "lang",
      "category",
      "animation",
      "cover_image",
      "svg_illustration",
      "title",
      "excerpt",
      "body"
    ],
    "note": "One row per language. EN, FR and ES versions share a translation key. Use the English, Français and Español bookmarks to filter.",
    "preview_url": "https://yesid.dev/blog/{{id}}?share={{$CURRENT_SHARE.token}}",
    "singleton": false,
    "sort": 1,
    "sort_field": "sort",
    "status": "active",
    "translations": [
      {
        "language": "en-US",
        "translation": "Blog posts",
        "singular": "post",
        "plural": "posts"
      }
    ],
    "unarchive_value": "published",
    "versioning": true
  },
  "schema": {
    "name": "blog_posts"
  }
}
