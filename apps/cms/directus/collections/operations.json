[
  {
    "name": "Check status published",
    "key": "check_published",
    "type": "condition",
    "position_x": 19,
    "position_y": 1,
    "options": {
      "filter": {
        "payload": {
          "status": {
            "_eq": "published"
          }
        }
      }
    },
    "resolve": "_sync_op_translation_reminder_log",
    "reject": null,
    "flow": "c80a68ad-dabf-4ccc-95cc-e97095f51d90",
    "_syncId": "_sync_op_translation_reminder_check_published"
  },
  {
    "name": "Log reminder",
    "key": "log_reminder",
    "type": "log",
    "position_x": 37,
    "position_y": 1,
    "options": {
      "message": "Translation reminder: {{$trigger.collection}} item(s) {{$trigger.keys}} published. Verify fr and es translation rows have content where applicable."
    },
    "resolve": "_sync_op_translation_reminder_notify",
    "reject": null,
    "flow": "c80a68ad-dabf-4ccc-95cc-e97095f51d90",
    "_syncId": "_sync_op_translation_reminder_log"
  },
  {
    "name": "Notify the editor",
    "key": "notify_editor",
    "type": "notification",
    "position_x": 55,
    "position_y": 1,
    "options": {
      "recipient": [
        "{{$accountability.user}}"
      ],
      "subject": "Check your languages",
      "message": "Switch on Show on site for each language you want live. Blog languages that are off or empty are hidden; for projects and services they fall back to English. When your editing session is done, use Publish site at the bottom of the sidebar."
    },
    "resolve": null,
    "reject": null,
    "flow": "c80a68ad-dabf-4ccc-95cc-e97095f51d90",
    "_syncId": "_sync_op_translation_reminder_notify"
  },
  {
    "name": "POST Publish hook",
    "key": "post_publish",
    "type": "request",
    "position_x": 19,
    "position_y": 1,
    "options": {
      "method": "POST",
      "url": "{{$env.VERCEL_DEPLOY_HOOK_URL}}?buildCache=false&source=directus-publish",
      "headers": [
        {
          "header": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": "{\"source\":\"directus.manual\",\"trigger\":\"publish_site_flow\"}"
    },
    "resolve": null,
    "reject": null,
    "flow": "d86a5982-6ab4-4474-ace8-cfd16962a9a4",
    "_syncId": "a7c9d628-b970-4f38-bb4b-0c532901d0e1"
  }
]
