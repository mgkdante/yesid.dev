# yesid.dev root dotenv reference file.
#
# Copy this file to `.env`, then supply every blank secret through the
# operator's chosen secret manager or shell. `.env` and app-local `.env.local`
# files are gitignored; never commit resolved credentials.

# Web runtime
PUBLIC_DIRECTUS_URL=https://cms.yesid.dev
OPENWEATHER_API_KEY=
# Web3Forms uses the public key exported from CMS contact content. It has no
# environment-variable alias.

# Directus admin ops
DIRECTUS_URL=https://cms.yesid.dev
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# Directus sync-push production guardrails.
# Uncomment only for an intentional production schema push.
# DIRECTUS_SYNC_ALLOW_PROD_SCHEMA_PUSH=1
# DIRECTUS_SYNC_PUSH_ACK=sync-push-can-delete-cms-data
