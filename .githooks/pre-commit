#!/usr/bin/env bash
# Pre-commit hook — two independent repository-integrity guards:
#
#   1. DESIGN  — require the schema-2 manifest whenever vendored payload files
#                change, so a release update is staged as one reviewable unit.
#   2. TOKENS  — block staged token output changes unless the vendored token
#                source or the product-owned adapter is also staged.
# Bypass (last resort, document in the PR): git commit --no-verify
set -euo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

# ============================================================================
# GUARD 1 — vendored design release
# ============================================================================
VENDOR_DESIGN_DIR="apps/web/vendor/design"
VENDOR_DESIGN_MANIFEST="$VENDOR_DESIGN_DIR/manifest.json"

vendor_payload_staged() {
  git diff --cached --name-only --diff-filter=ACMRD -- "$VENDOR_DESIGN_DIR" \
    | grep -Fvx "$VENDOR_DESIGN_MANIFEST" \
    | grep -q .
}

vendor_manifest_staged() {
  git diff --cached --name-only --diff-filter=ACMR -- "$VENDOR_DESIGN_MANIFEST" \
    | grep -Fxq "$VENDOR_DESIGN_MANIFEST"
}

if vendor_payload_staged && ! vendor_manifest_staged; then
  echo "ERROR: Vendored design payload files changed without a staged manifest."
  echo ""
  echo "  Adopt the complete release from apps/web, then stage the payload and:"
  echo "    $VENDOR_DESIGN_MANIFEST"
  echo "  Verify the staged release from apps/web with:"
  echo "    bun vendor/design/tools/adopt.ts --check --dest vendor/design"
  echo ""
  echo "Bypass (last resort): git commit --no-verify"
  exit 1
fi

# ============================================================================
# GUARD 2 — design tokens
# ============================================================================
TOKEN_GENERATED_FULL=(
  "DESIGN.md"
)
TOKEN_MIXED_APP_CSS="apps/web/src/app.css"
# Regex matching any file path that legitimately invalidates generated outputs.
TOKEN_SOURCE_REGEX='^(apps/web/vendor/design/tokens/.+|apps/web/tools/build-tokens\.ts)$'

app_css_token_region() {
  awk '
    /\/\* ===== TOKENS:START ===== \*\// { in_region=1 }
    in_region { print }
    /\/\* ===== TOKENS:END ===== \*\// { in_region=0 }
  '
}

app_css_token_region_changed() {
  local head_region staged_region
  head_region="$(git show "HEAD:$TOKEN_MIXED_APP_CSS" 2>/dev/null | app_css_token_region || true)"
  staged_region="$(git show ":$TOKEN_MIXED_APP_CSS" 2>/dev/null | app_css_token_region || true)"
  [ "$head_region" != "$staged_region" ]
}

token_generated_staged=0
for f in "${TOKEN_GENERATED_FULL[@]}"; do
  if staged | grep -qx "$f"; then
    token_generated_staged=1
    break
  fi
done
if staged | grep -qx "$TOKEN_MIXED_APP_CSS" && app_css_token_region_changed; then
  token_generated_staged=1
fi

if [ "$token_generated_staged" -eq 1 ]; then
  if ! staged | grep -qE "$TOKEN_SOURCE_REGEX"; then
    echo "ERROR: A generated token file is staged, but neither the vendored"
    echo "       token source nor the product-owned adapter is staged."
    echo "       Adopt a release that changes apps/web/vendor/design/tokens/,"
    echo "       or update apps/web/tools/build-tokens.ts, then run:"
    echo "         bun run tokens:build"
    echo ""
    echo "Generated files:"
    for f in "${TOKEN_GENERATED_FULL[@]}"; do
      if staged | grep -qx "$f"; then echo "  • $f"; fi
    done
    if staged | grep -qx "$TOKEN_MIXED_APP_CSS" && app_css_token_region_changed; then
      echo "  • $TOKEN_MIXED_APP_CSS (generated token region)"
    fi
    echo ""
    echo "Bypass (last resort): git commit --no-verify"
    exit 1
  fi
fi

exit 0
