{
	"name": "yesid-dev",
	"private": true,
	"type": "module",
	"description": "yesid.dev monorepo - apps/web (SvelteKit consumer) + apps/cms (Directus config).",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "cd apps/web && bun run dev",
		"dev:op": "op run --env-file=.env -- bun run dev",
		"dev:local-env": "bun --env-file=apps/web/.env.local run dev",
		"build": "turbo run build",
		"build:op": "EXPORT_FALLBACKS_SOURCE=live op run --env-file=.env -- turbo run build --force",
		"test": "turbo run test",
		"check": "turbo run check",
		"cms:sync:diff:op": "op run --env-file=.env -- bun run --cwd apps/cms sync:diff",
		"cms:sync:push:op": "op run --env-file=.env -- bun run --cwd apps/cms sync:push",
		"cms:sync:diff:local-env": "bun run --env-file=apps/cms/.env.local --cwd apps/cms sync:diff",
		"secrets:inject:web": "op inject -i .env -o apps/web/.env.local",
		"secrets:inject:cms": "op inject -i .env -o apps/cms/.env.local",
		"secrets:whoami": "op whoami",
		"secrets:ratelimit": "op service-account ratelimit"
	},
	"devDependencies": {
		"@yesid/config": "https://github.com/mgkdante/yesid.dev-design/releases/download/v0.29.0/yesid-config-0.29.0.tgz",
		"turbo": "^2.5.0"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"devalue": "5.9.3",
		"dompurify": "3.4.17",
		"fast-xml-builder": "1.1.7",
		"happy-dom": "21.0.4",
		"nanoid": "3.3.18",
		"postcss": "8.5.23",
		"satori": "0.10.14",
		"svgo": "4.1.0",
		"tar": "7.5.21",
		"undici": "7.29.1",
		"vite": "8.3.5",
		"ws": "8.21.0"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22.23.4"
	}
}
